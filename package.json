{
  "name": "org-saas",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tests"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/node": "^26.6.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "vite": "npm:@voidzero-dev/vite-plus-core@^1.6.0",
      "@vitejs/plugin-react": "^6.3.0",
      "oxc-transform-react": "^0.158.0",
      "tailwindcss": "^4.3.5",
      "@tailwindcss/vite": "^4.3.5",
      "tailwind-merge": "^3.7.0",
      "dotenv": "^18.0.10",
      "zod": "^4.6.7",
      "lucide-react": "^1.73.0",
      "pino": "^10.4.0",
      "fumadocs-core": "^16.19.1",
      "fumadocs-mdx": "^15.6.2",
      "fumadocs-ui": "^16.19.1",
      "@types/mdx": "^2.0.14",
      "@orpc/server": "2.0.0-beta.50",
      "@orpc/contract": "2.0.0-beta.50",
      "@orpc/client": "2.0.0-beta.50",
      "@orpc/openapi": "2.0.0-beta.50",
      "@orpc/json-schema": "2.0.0-beta.50",
      "@orpc/zod": "2.0.0-beta.50",
      "@orpc/tanstack-query": "2.0.0-beta.50",
      "@orpc/pino": "2.0.0-beta.50",
      "@orpc/ratelimit": "2.0.0-beta.50",
      "better-auth": "^1.7.23",
      "@better-auth/core": "1.7.23",
      "@tanstack/react-router": "^1.170.46",
      "@tanstack/react-start": "^1.169.5",
      "vite-plus": "^1.6.0",
      "solid-js": "2.0.0-rc.21",
      "@solidjs/web": "2.0.0-rc.21",
      "@solidjs/vite-plugin": "3.0.0-next.57",
      "@solidjs/babel-plugin": "2.0.0-rc.21",
      "@tanstack/solid-start": "2.0.0-rc.10",
      "@tanstack/solid-router": "2.0.0-rc.10",
      "@tanstack/solid-router-devtools": "2.0.0-rc.8",
      "@tanstack/solid-query": "6.0.0-rc.5",
      "@ui-sdk/solid": "0.1.0-beta.2",
      "@ui-sdk/core": "0.1.0-beta.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter web --filter fumadocs dev",
    "dev:web": "vp run --filter web dev",
    "dev:fumadocs": "vp run --filter fumadocs dev",
    "build": "vp run --parallel --filter web --filter fumadocs build",
    "db:push": "vp run --filter @org-saas/db db:push",
    "db:studio": "vp run --filter @org-saas/db db:studio",
    "db:generate": "vp run --filter @org-saas/db db:generate",
    "db:migrate": "vp run --filter @org-saas/db db:migrate",
    "audit:prune": "vp run --filter @org-saas/db audit:prune",
    "inventory:auth": "vp run --filter @org-saas/auth inventory:auth",
    "check": "bun scripts/check-layout.ts && vp check",
    "fix": "vp check --fix",
    "test": "vp test",
    "test:e2e": "vp run --filter @org-saas/tests test:e2e",
    "clean": "git clean -xdf -- ':(glob)**/node_modules/**' ':(glob)**/.dist/**' ':(glob)**/.output/**' ':(glob)**/.tanstack/**' ':(glob)**/.wrangler/**'",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@org-saas/env": "workspace:*"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
